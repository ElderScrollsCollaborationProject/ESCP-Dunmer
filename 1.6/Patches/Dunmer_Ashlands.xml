<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Mashed's Ashlands</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/XenotypeDef[defName="ESCP_Xenotype_Dunmer"]/genes</xpath>
                    <value>
                        <li>Mashed_Ashlands_AshResistance_Partial</li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/FactionDef[defName="ESCP_Faction_House_Redoran" or defName="ESCP_Faction_House_Telvanni"]/pawnGroupMakers/li/carriers</xpath>
                    <value>
                        <Mashed_Ashlands_Guar>8</Mashed_Ashlands_Guar>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/TraderKindDef[defName="ESCP_Caravan_Dunmer_Trader"]/stockGenerators</xpath>
                    <value>
                        <li Class="StockGenerator_Tag">
                            <tradeTag>Mashed_Ashlands_AshlandsAlcohol</tradeTag>
                            <thingDefCountRange>2~4</thingDefCountRange>
                            <countRange>10~30</countRange>
                        </li>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>

</Patch>
