<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/FactionDef[defName="ESCP_Faction_House_Redoran"]</xpath>
        <value>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <settlementNames>
                    <li>Blacklight</li>
                    <li>Ald'ruhn</li>
                    <li>Maar Gan</li>
                    <li>Ald Velothi</li>
                    <li>Kragenmoor</li>
                </settlementNames>
                <preferredHilliness />
                <allowedBiomes>
                    <li>AridShrubland</li>
                    <li>Desert</li>
                </allowedBiomes>
                <clustered>true</clustered>
            </li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/FactionDef[defName="ESCP_Faction_House_Telvanni"]</xpath>
        <value>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <settlementNames>
                    <li>Sadrith Mora</li>
                    <li>Tel Vos</li>
                    <li>Tel Mora</li>
                    <li>Tel Naga</li>
                    <li>Tel Aruhn</li>
                    <li>Tel Mithryn</li>
                </settlementNames>
                <preferredHilliness />
                <allowedBiomes>
                    <li>AridShrubland</li>
                    <li>Desert</li>
                </allowedBiomes>
                <clustered>true</clustered>
            </li>
        </value>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Mashed's Ashlands</li>
        </mods>
        <match Class="PatchOperationAdd">
            <xpath>Defs/FactionDef[defName="ESCP_Faction_House_Redoran" or defName="ESCP_Faction_House_Telvanni"]/modExtensions/li[@Class="ESCP.Factions.FactionExtension_NamedSettlement"]/allowedBiomes</xpath>
            <value>
                            <li>Mashed_Ashlands_Ashlands</li>
                            <li>Mashed_Ashlands_DustplainAshlands</li>
                            <li>Mashed_Ashlands_GrazelandAshlands</li>
                            <li>Mashed_Ashlands_HighlandAshlands</li>
                            <li>Mashed_Ashlands_SwampAshlands</li>
                            <li>Mashed_Ashlands_ForestAshlands</li>
                            <li>Mashed_Ashlands_MarshAshlands</li>
                            <li>Mashed_Ashlands_MeadowAshlands</li>
                            <li>Mashed_Ashlands_VolcanicAshlands</li>
                            <li>Mashed_Ashlands_VolcanicBadlandAshlands</li>
                            <li>Mashed_Ashlands_VolcanicBasaltHillsAshlands</li>
                            <li>Mashed_Ashlands_VolcanicGroveAshlands</li>
            </value>
        </match>
    </Operation>

</Patch>
