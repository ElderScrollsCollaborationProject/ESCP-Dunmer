<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>ESCP_Faction_House_Telvanni</defName>
        <label>House Telvanni</label>
        <description>The Great House of wizards, ruled by a council of Mouths who speak for masters too busy or too paranoid to attend. Telvanni law comes down to this: whoever can take something and keep it deserves it. Their towers are grown from giant mushrooms, their slaves are numerous, and their internal politics are carried out with fireballs.</description>
        <colorSpectrum>
            <li>(0.45, 0.25, 0.55)</li>
        </colorSpectrum>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <pawnSingular>Dunmer</pawnSingular>
        <pawnsPlural>Dunmer</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <settlementGenerationWeight>0.2</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>Archmagister</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/Empire</factionIconPath>
        <techLevel>Medieval</techLevel>
        <fixedName>House Telvanni</fixedName>
        <allowedCultures>
            <li>ESCP_Culture_Dunmer</li>
        </allowedCultures>

        <royalTitleTags>
            <li>ESCP_Title_Dunmer</li>
        </royalTitleTags>
        <royalFavorLabel>Telvanni Regard</royalFavorLabel>
        <royalTitleInheritanceWorkerClass>RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>

        <fixedIdeo>true</fixedIdeo>
        <ideoName>The Telvanni Way</ideoName>
        <ideoDescription>Telvanni honor the Reclamations when it suits them and the Daedra when that suits them better. Power is its own argument. A master owes nothing to the weak but the courtesy of an honest threat, and a student who overthrows a teacher has only completed the course.</ideoDescription>
        <deityPresets>
            <li>
                <nameType><name>Almalexia</name><type>Mother Morrowind, Face of Mercy</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
            <li>
                <nameType><name>Vivec</name><type>Warrior-Poet of the Tribunal</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
            <li>
                <nameType><name>Sotha Sil</name><type>the Clockwork God</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
            <li>
                <nameType><name>Boethiah</name><type>Prince of Plots and teacher of the Chimer</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityBoethiah</iconPath>
            </li>
            <li>
                <nameType><name>Mephala</name><type>Webspinner and Anticipation</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/ESCP_DeityMephala</iconPath>
            </li>
            <li>
                <nameType><name>Azura</name><type>Mother of the Rose, who cursed the Dunmer</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/ESCP_DeityAzura</iconPath>
            </li>
            <li>
                <nameType><name>Nerevar</name><type>the Moon-and-Star who will return</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
        </deityPresets>
        <styles>
            <li>ESCP_Style_Dunmer</li>
        </styles>
        <forcedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">ESCP_Meme_Reclamations</li>
        </forcedMemes>
        <requiredPreceptsOnly>true</requiredPreceptsOnly>

        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_Dunmer_Child</li>
                    <li>ESCP_Backstory_Dunmer_Citizen</li>
                    <li>ESCP_Backstory_Dunmer_Military</li>
                    <li>ESCP_Backstory_Dunmer_Mage</li>
                </categories>
            </li>
        </backstoryFilters>

        <caravanTraderKinds>
            <li>ESCP_Caravan_Dunmer_Trader</li>
        </caravanTraderKinds>
        <visitorTraderKinds>
            <li>ESCP_Caravan_Dunmer_Trader</li>
        </visitorTraderKinds>
        <baseTraderKinds>
            <li>ESCP_Caravan_Dunmer_Trader</li>
        </baseTraderKinds>

        <allowedArrivalTemperatureRange>-20~60</allowedArrivalTemperatureRange>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <options>
                    <ESCP_Pawnkind_Dunmer_Melee>10</ESCP_Pawnkind_Dunmer_Melee>
                    <ESCP_Pawnkind_Dunmer_Ranged>7</ESCP_Pawnkind_Dunmer_Ranged>
                    <ESCP_Pawnkind_Dunmer_Mage>4</ESCP_Pawnkind_Dunmer_Mage>
                    <ESCP_Pawnkind_Dunmer_Captain>3</ESCP_Pawnkind_Dunmer_Captain>
                    <ESCP_Pawnkind_Dunmer_Elite>2</ESCP_Pawnkind_Dunmer_Elite>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <ESCP_Pawnkind_Dunmer_Citizen>15</ESCP_Pawnkind_Dunmer_Citizen>
                    <ESCP_Pawnkind_Dunmer_Merchant>6</ESCP_Pawnkind_Dunmer_Merchant>
                    <ESCP_Pawnkind_Dunmer_Noble>4</ESCP_Pawnkind_Dunmer_Noble>
                    <ESCP_Pawnkind_Dunmer_Mage>3</ESCP_Pawnkind_Dunmer_Mage>
                </options>
            </li>
            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <ESCP_Pawnkind_Dunmer_Trader>1</ESCP_Pawnkind_Dunmer_Trader>
                    <ESCP_Pawnkind_Dunmer_Quartermaster>1</ESCP_Pawnkind_Dunmer_Quartermaster>
                </traders>
                <carriers>
                    <Muffalo>6</Muffalo>
                    <Dromedary>5</Dromedary>
                    <Alpaca>3</Alpaca>
                </carriers>
                <guards>
                    <ESCP_Pawnkind_Dunmer_Melee>8</ESCP_Pawnkind_Dunmer_Melee>
                    <ESCP_Pawnkind_Dunmer_Ranged>5</ESCP_Pawnkind_Dunmer_Ranged>
                    <ESCP_Pawnkind_Dunmer_Elite>1</ESCP_Pawnkind_Dunmer_Elite>
                </guards>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <ESCP_Pawnkind_Dunmer_Citizen>8</ESCP_Pawnkind_Dunmer_Citizen>
                    <ESCP_Pawnkind_Dunmer_Melee>10</ESCP_Pawnkind_Dunmer_Melee>
                    <ESCP_Pawnkind_Dunmer_Ranged>8</ESCP_Pawnkind_Dunmer_Ranged>
                    <ESCP_Pawnkind_Dunmer_Mage>4</ESCP_Pawnkind_Dunmer_Mage>
                    <ESCP_Pawnkind_Dunmer_Elite>2</ESCP_Pawnkind_Dunmer_Elite>
                </options>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>

        <modExtensions Inherit="False">
            <li Class="ESCP_RaceTools.FactionProperties">
                <factionTags>
                    <li>ESCP_GreatHouse</li>
                </factionTags>
            </li>
            <li Class="ESCP.Factions.FactionExtension_FlavorOverride">
                <newLabel>House Telvanni</newLabel>
            </li>
            <li Class="ESCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <li Class="ESCP.Enlist.FactionEnlistOptions">
                <enlistOptionsDefs>
                    <li>ESCP_Enlistment_HouseTelvanni</li>
                </enlistOptionsDefs>
            </li>
            <li Class="ESCP.Ranks.FactionExtension_RankTracks">
                <rankTracks>
                    <li>ESCP_RankTrack_HouseTelvanni</li>
                </rankTracks>
            </li>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <settlementNames>
                    <li>Sadrith Mora</li>
                    <li>Tel Vos</li>
                    <li>Tel Mora</li>
                    <li>Tel Naga</li>
                    <li>Tel Aruhn</li>
                    <li>Tel Mithryn</li>
                </settlementNames>
                <preferredHilliness />
                <allowedBiomes>
                    <li>AridShrubland</li>
                    <li>Desert</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_Ashlands</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_DustplainAshlands</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_GrazelandAshlands</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_HighlandAshlands</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_SwampAshlands</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_ForestAshlands</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_MarshAshlands</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_MeadowAshlands</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_VolcanicAshlands</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_VolcanicBadlandAshlands</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_VolcanicBasaltHillsAshlands</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_VolcanicGroveAshlands</li>
                </allowedBiomes>
                <clustered>true</clustered>
            </li>
        </modExtensions>
    </FactionDef>

</Defs>
