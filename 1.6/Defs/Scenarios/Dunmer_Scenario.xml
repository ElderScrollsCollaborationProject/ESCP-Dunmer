<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ScenarioDef>
        <defName>ESCP_Scenario_Dunmer</defName>
        <label>Velothi Refuge</label>
        <description>Dunmer driven out by ash and old quarrels, trying again somewhere nobody has yet buried a grandmother. They brought the family urns.</description>
        <scenario>
            <summary>Dunmer driven out by ash and old quarrels, trying again somewhere nobody has yet buried a grandmother. They brought the family urns.</summary>
            <playerFaction>
                <def>PlayerFaction</def>
                <factionDef>ESCP_Faction_Dunmer_Player</factionDef>
            </playerFaction>
            <surfaceLayer>
                <def>SurfaceLayerFixed</def>
                <tag>Surface</tag>
                <layer>Surface</layer>
                <settingsDef>Surface</settingsDef>
                <hide>true</hide>
                <connections>
                    <Orbit MayRequire="Ludeon.RimWorld.Odyssey">
                        <zoomMode>ZoomOut</zoomMode>
                    </Orbit>
                </connections>
            </surfaceLayer>
            <parts>
                <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
                    <def>ConfigPage_ConfigureStartingPawns</def>
                    <pawnCount>4</pawnCount>
                    <pawnChoiceCount>8</pawnChoiceCount>
                </li>
                <li Class="ScenPart_PlayerPawnsArriveMethod">
                    <def>PlayerPawnsArriveMethod</def>
                    <method>Standing</method>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Silver</thingDef>
                    <count>400</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Pemmican</thingDef>
                    <count>200</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MedicineHerbal</thingDef>
                    <count>20</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>WoodLog</thingDef>
                    <count>300</count>
                </li>
            </parts>
        </scenario>
    </ScenarioDef>

</Defs>
