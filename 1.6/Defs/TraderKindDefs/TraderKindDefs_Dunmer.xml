<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <TraderKindDef>
        <defName>ESCP_Caravan_Dunmer_Trader</defName>
        <label>Dunmer trader</label>
        <modExtensions>
            <li Class="ESCP.Currencies.CurrencyReplacement">
                <currency>ESCP_Currency_Septims</currency>
            </li>
        </modExtensions>

        <stockGenerators>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>300~800</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Steel</thingDef>
                <countRange>60~180</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>WoodLog</thingDef>
                <countRange>40~120</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Leather_Plain</thingDef>
                <countRange>40~110</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>MedicineHerbal</thingDef>
                <countRange>10~28</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Pemmican</thingDef>
                <countRange>60~150</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Beer</thingDef>
                <countRange>15~40</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>ESCP_Tome_Healing</thingDef>
                <countRange>1~2</countRange>
            </li>

            <li Class="StockGenerator_BuyTradeTag">
                <tag>Art</tag>
            </li>

            <li Class="StockGenerator_BuyTradeTag">
                <tag>ExoticMisc</tag>
            </li>
            <li Class="ESCP.Enlist.StockGenerator_Pawns" />
            <li Class="StockGenerator_Tag" MayRequire="SirMashedPotato.Ashlands">
                <tradeTag>Mashed_Ashlands_AshlandsAlcohol</tradeTag>
                <thingDefCountRange>2~4</thingDefCountRange>
                <countRange>10~30</countRange>
            </li>
            <li Class="StockGenerator_SingleDef" MayRequire="ESCP.DunmerArmory">
                <thingDef>InsectJelly</thingDef>
                <countRange>40~100</countRange>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>ESCP_Resources_Raw</categoryDef>
                <thingDefCountRange>2~4</thingDefCountRange>
                <totalPriceRange>150~500</totalPriceRange>
            </li>
            <li Class="StockGenerator_Tag">
                <tradeTag>ESCP_ElementalSalts</tradeTag>
                <thingDefCountRange>1~2</thingDefCountRange>
                <countRange>4~12</countRange>
            </li>
            <li Class="StockGenerator_BuyTradeTag">
                <tag>ESCP_Bullion</tag>
            </li>

        </stockGenerators>

        <tradeCurrency>Silver</tradeCurrency>

    </TraderKindDef>

</Defs>
