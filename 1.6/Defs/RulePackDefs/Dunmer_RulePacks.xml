<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <RulePackDef>
        <defName>ESCP_DunmerNamerRoleAncestorSpeaker</defName>
        <include>
            <li>NamerRoleSpecialistUtility</li>
        </include>
        <rulePack>
            <rulesStrings>
                <li>r_roleName->speaker</li>
                <li>r_roleName->whisperer</li>
                <li>r_roleName->voice</li>
                <li>r_roleName->mouth</li>
                <li>r_roleName->conduit</li>
                <li>firstPart->ancestor</li>
                <li>firstPart->ancestral</li>
                <li>firstPart->tomb</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

    <RulePackDef>
        <defName>ESCP_DunmerNamerRitualSeance</defName>
        <rulePack>
            <rulesStrings>
                <li>r_ritualName(p=2)->[memeAdjective] [seance]</li>
                <li>r_ritualName->[seance] of [chosenTheme]</li>
                <li>r_ritualName->[chosenAdjective] [seance]</li>
                <li>r_ritualName->[keyDeity]'s [seance]</li>
                <li>r_ritualName->[seance] of [memeConcept]</li>
                <li>r_ritualName->[seance] of [chosenIdeoName]</li>
                <li>seance->seance</li>
                <li>seance->whispers</li>
                <li>seance->gathering</li>
                <li>seance->tomb rite</li>
                <li>seance->guidance</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

</Defs>
