<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThoughtDef>
        <defName>ESCP_DunmerTerribleSeance</defName>
        <thoughtClass>Thought_AttendedRitual</thoughtClass>
        <durationDays>6</durationDays>
        <stackLimit>3</stackLimit>
        <stages>
            <li>
                <label>disgraceful seance</label>
                <description>That seance was close to an insult to the ancestors.</description>
                <baseMoodEffect>-3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_DunmerLacklusterSeance</defName>
        <thoughtClass>Thought_AttendedRitual</thoughtClass>
        <durationDays>6</durationDays>
        <stackLimit>3</stackLimit>
        <stages>
            <li>
                <label>lackluster seance</label>
                <description>That seance dragged on and the dead had nothing useful to say.</description>
                <baseMoodEffect>-1</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_DunmerGoodSeance</defName>
        <thoughtClass>Thought_AttendedRitual</thoughtClass>
        <durationDays>6</durationDays>
        <stackLimit>3</stackLimit>
        <stages>
            <li>
                <label>good seance</label>
                <description>The ancestors answered us. It is good to know they are still watching.</description>
                <baseMoodEffect>5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ESCP_DunmerEnlighteningSeance</defName>
        <thoughtClass>Thought_AttendedRitual</thoughtClass>
        <durationDays>6</durationDays>
        <stackLimit>3</stackLimit>
        <stages>
            <li>
                <label>enlightening seance</label>
                <description>The dead spoke clearly tonight. I know what to do now, and I have the strength to do it.</description>
                <baseMoodEffect>8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>
