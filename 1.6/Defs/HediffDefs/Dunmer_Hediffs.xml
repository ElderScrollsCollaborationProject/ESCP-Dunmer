<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>ESCP_Hediff_Dunmer_Ancestors_Wrath</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>ancestor's wrath</label>
        <description>The family dead are close. This person's blows land harder and fire barely troubles them.</description>
        <defaultLabelColor>(0.9, 0.35, 0.2)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>2700~2700</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <MeleeDamageFactor>1.35</MeleeDamageFactor>
                    <IncomingDamageFactor>0.85</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

    <HediffDef Name="ESCP_DunmerAncestralBuffBase" ParentName="RoleStatBuff" Abstract="True">
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <showRemainingTime>True</showRemainingTime>
            </li>
            <li Class="HediffCompProperties_DisappearsOnDeath" />
        </comps>
    </HediffDef>

    <HediffDef ParentName="ESCP_DunmerAncestralBuffBase">
        <defName>ESCP_Dunmer_AncestralGuidance</defName>
        <label>ancestral guidance</label>
        <description>The family dead are steadying this person's mind. Mental breaks are much less likely.</description>
        <stages>
            <li>
                <statOffsets>
                    <MentalBreakThreshold>-0.50</MentalBreakThreshold>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="ESCP_DunmerAncestralBuffBase">
        <defName>ESCP_Dunmer_AncestralHealing</defName>
        <label>ancestral healing</label>
        <description>The family dead are helping this person's body mend. Wounds heal faster.</description>
        <stages>
            <li>
                <statOffsets>
                    <InjuryHealingFactor>0.25</InjuryHealingFactor>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="ESCP_DunmerAncestralBuffBase">
        <defName>ESCP_Dunmer_AncestralProtection</defName>
        <label>ancestor guardian</label>
        <description>An ancestor stands guard over this person, turning aside part of every blow.</description>
        <stages>
            <li>
                <statOffsets>
                    <IncomingDamageFactor>-0.15</IncomingDamageFactor>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="ESCP_DunmerAncestralBuffBase">
        <defName>ESCP_Dunmer_AncestralSight</defName>
        <label>ancestral sight</label>
        <description>The voices of the dead are close to this person, who is more sensitive to psychic effects.</description>
        <stages>
            <li>
                <statOffsets>
                    <PsychicSensitivity>0.25</PsychicSensitivity>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="ESCP_DunmerAncestralBuffBase">
        <defName>ESCP_Dunmer_AncestralWisdom</defName>
        <label>ancestral wisdom</label>
        <description>This person carries some of what the family dead learned in life, and picks up new skills faster.</description>
        <stages>
            <li>
                <statOffsets>
                    <GlobalLearningFactor>0.25</GlobalLearningFactor>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

</Defs>
